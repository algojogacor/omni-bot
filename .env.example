# Server
PORT=8000
NODE_ENV=production
TZ=Asia/Jakarta

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
ALLOWED_TELEGRAM_USER_ID=123456789

# Database (Turso libSQL)
# Gunakan libsql://... untuk production Turso, atau file:data/omni.db untuk lokal
TURSO_DATABASE_URL=file:data/omni.db
TURSO_AUTH_TOKEN=

# Groq LLM (pisahkan dengan koma jika ada beberapa key dari berbagai akun)
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Google Calendar (Service Account)
GOOGLE_CLIENT_EMAIL="omnibot-calendar@mesin-cuan-en-horror.iam.gserviceaccount.com"
